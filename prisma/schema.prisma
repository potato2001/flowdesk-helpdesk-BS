generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REQUESTER
  AGENT
  MANAGER
  ADMIN
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum ActivityType {
  TICKET_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  SLA_BREACHED
  TICKET_RESOLVED
}

model User {
  id                  String       @id @default(uuid()) @db.Uuid
  email               String       @unique @db.VarChar(255)
  name                String       @db.VarChar(120)
  passwordHash        String       @db.VarChar(255)
  role                Role         @default(REQUESTER)
  department          String?      @db.VarChar(120)
  active              Boolean      @default(true)
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?    @db.Timestamptz(3)
  passwordChangedAt   DateTime     @default(now()) @db.Timestamptz(3)
  mustChangePassword  Boolean      @default(false)
  requestedTickets    Ticket[]     @relation("TicketRequester")
  assignedTickets     Ticket[]     @relation("TicketAssignee")
  comments            Comment[]
  attachments         Attachment[]
  activities          Activity[]
  sessions            Session[]
  auditLogs           AuditLog[]   @relation("AuditActor")
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)

  @@index([role, active])
  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(100)
  targetType String   @db.VarChar(80)
  targetId   String?  @db.VarChar(120)
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Ticket {
  id                    String         @id @default(uuid()) @db.Uuid
  number                Int            @unique @default(autoincrement())
  title                 String         @db.VarChar(240)
  description           String         @db.Text
  category              String         @db.VarChar(100)
  status                TicketStatus   @default(NEW)
  priority              TicketPriority @default(MEDIUM)
  requesterId           String         @db.Uuid
  requester             User           @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assigneeId            String?        @db.Uuid
  assignee              User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  responseDueAt         DateTime       @db.Timestamptz(3)
  resolutionDueAt       DateTime       @db.Timestamptz(3)
  firstRespondedAt      DateTime?      @db.Timestamptz(3)
  resolvedAt            DateTime?      @db.Timestamptz(3)
  responseSlaBreached   Boolean        @default(false)
  resolutionSlaBreached Boolean        @default(false)
  comments              Comment[]
  attachments           Attachment[]
  activities            Activity[]
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)

  @@index([status, priority])
  @@index([assigneeId, status])
  @@index([requesterId, createdAt])
  @@index([responseDueAt])
  @@index([resolutionDueAt])
  @@map("tickets")
}

model Comment {
  id          String            @id @default(uuid()) @db.Uuid
  ticketId    String            @db.Uuid
  ticket      Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String            @db.Uuid
  author      User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body        String            @db.Text
  visibility  CommentVisibility @default(PUBLIC)
  attachments Attachment[]
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([ticketId, createdAt])
  @@map("comments")
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @db.Uuid
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId    String?  @db.Uuid
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  uploadedById String   @db.Uuid
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  fileName     String   @db.VarChar(255)
  storageKey   String   @unique @db.VarChar(500)
  mimeType     String   @db.VarChar(150)
  sizeBytes    Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([ticketId, createdAt])
  @@map("attachments")
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  ticketId  String       @db.Uuid
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?      @db.Uuid
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      ActivityType
  summary   String       @db.VarChar(500)
  metadata  Json?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([ticketId, createdAt])
  @@map("activities")
}

model SlaPolicy {
  id                String         @id @default(uuid()) @db.Uuid
  name              String         @db.VarChar(120)
  priority          TicketPriority @unique
  responseMinutes   Int
  resolutionMinutes Int
  businessHoursOnly Boolean        @default(true)
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  @@map("sla_policies")
}
