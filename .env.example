# PostgreSQL local. Docker Compose overrides the hostname with `postgres`.
DATABASE_URL="postgresql://flowdesk:flowdesk@localhost:5432/flowdesk?schema=public"
SESSION_SECRET="change-this-to-a-random-local-secret"
SESSION_COOKIE_SECURE="false"
UPLOAD_DIR="./data/uploads"
SEED_ADMIN_EMAIL="admin@bravestars.local"
SEED_ADMIN_PASSWORD="Flowdesk@123"
